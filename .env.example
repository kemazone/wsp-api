# Puerto local (IIS publica el servicio como https://kema.from-de.com/<carpeta>). Sugerido: 3200 PROD, 5200 TEST
PORT=3200

# SQL Server
DB_HOST=localhost
DB_PORT=1433
# DB_INSTANCE=DEV2019      <- solo con instancia con nombre (se ignora DB_PORT)
DB_NAME=wsp_api
DB_USER=sa
DB_PASS=
DB_ENCRYPT=0
DB_TRUST_CERT=1
# DB_LENTA_MS=3000         <- avisa en el log las consultas que tardan más (0 = no)

# Clave para cifrar los Access Token de Meta y los secretos de las suscripciones guardados en la base.
# Valor largo y aleatorio. Si se cambia, hay que volver a cargar los tokens de los números.
CLAVE_CIFRADO=

# Token del administrador de la plataforma (header X-Admin-Token en /api/admin). Mínimo 24 caracteres.
ADMIN_TOKEN=

# Meta (app de developers.facebook.com). Ver docs/configuracion-meta.md
# App Secret: Configuración de la app > Básica > Clave secreta de la app. Valida la firma de los webhooks.
META_APP_SECRET=
# Token de verificación: un texto inventado por nosotros; el mismo se carga en WhatsApp > Configuración > Webhook
META_VERIFY_TOKEN=
# META_GRAPH_VERSION=v26.0
# META_TIMEOUT_MS=20000

# Reenvío de eventos a las apps suscriptas
# ENTREGAS_INTERVALO_S=15    <- cada cuánto se revisan los reintentos (0 = desactivado)
# ENTREGAS_MAX_INTENTOS=8    <- después de eso la entrega queda FALLIDA (se puede reintentar a mano)
# ENTREGAS_TIMEOUT_MS=10000
# EVENTOS_META_DIAS=30       <- días que se guardan los webhooks crudos de Meta (0 = no borrar)

# Política de privacidad pública en /privacidad (Meta pide la URL para publicar la app)
# PRIVACIDAD_TITULAR=Kema
# PRIVACIDAD_EMAIL=contacto@ejemplo.com
# PRIVACIDAD_FECHA=20/11/2026

# Log en archivo (mismo esquema que gestion-app; ver src/log.js)
# LOG_ARCHIVO=1
# LOG_DIR=logs
# LOG_NIVEL=info
# LOG_DIAS=30
# LOG_TAMANO_MB=20
# LOG_PEDIDOS=0
