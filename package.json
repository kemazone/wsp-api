{
  "name": "wsp-api",
  "version": "0.2.0",
  "description": "API REST propia para WhatsApp (Cloud API de Meta): envío, recepción, estados y reenvío de eventos a las apps de la plataforma",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrar": "node src/migrar.js",
    "backup": "node src/backup.js",
    "test": "node test/ejecutar.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sequelize": "^6.37.3",
    "swagger-ui-express": "^5.0.1",
    "tedious": "^18.2.0",
    "yaml": "^2.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
